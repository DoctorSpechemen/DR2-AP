@@ -118,6 +117,24 @@ static DWORD __stdcall GetControllerState(const DWORD player_index, XINPUT_STATE
             output_state->Gamepad.sThumbLY = ~SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_LEFTY);
