--- a/DR2Fix/DllMain.cpp
+++ b/DR2Fix/DllMain.cpp
@@ -7,7 +7,8 @@ BOOL APIENTRY DllMain(HMODULE hModule, DWORD dwReason, LPVOID lpReserved) {
 		DisableThreadLibraryCalls(hModule);
 		break;
 	case DLL_PROCESS_DETACH:
-		FreeLibraryAndExitThread(hModule, TRUE);
+		// Nothing to do. In particular, do not call 'FreeLibraryAndExitThread' here: this runs under the
